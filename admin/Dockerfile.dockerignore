# 构建上下文是仓库根目录，只放 Admin 需要的文件（见 Dockerfile 开头）
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!admin
!api/package.json
!packages/contract
!shared/config-schema
!shared/agent-tools
!shared/diagnostics
!ios/Vita/Resources/DefaultConfig.json
admin/node_modules
packages/contract/node_modules
admin/.next
admin/.data
admin/.env*
!admin/.env.example
admin/src/generated
admin/*.tsbuildinfo
