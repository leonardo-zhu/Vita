# Vita API 的环境变量。复制为 .env.local 即可在本地 `pnpm dev`；生产在 R4S 的 /opt/stacks/vita-api/.env 维护。

# Admin 调 API 用的服务令牌，两边的 .env 填同一个值。至少 32 个字符，用 openssl rand -base64 32 生成。
# 更换后 Admin 要同步更新，手机的设备令牌不受影响。
VITA_API_SERVICE_TOKEN=

# 模型网关 Conduit。密钥用 Conduit 后台给 Vita 应用建的密钥；手机上不再有模型密钥（架构设计 §8）。
# 没配时对话接口返回 503，其余照常。
CONDUIT_BASE_URL=https://conduit.r4s.leonardo-zhu.me
CONDUIT_API_KEY=

# Admin 发布的配置文件；没有时用内置默认值（shared/config/DefaultConfig.json，打包进镜像）
# VITA_API_PUBLISHED_CONFIG=/published/stable.json

# 标签照片等文件的目录，默认数据目录下的 files/
# VITA_API_FILES_DIR=/data/files

# 监听地址与端口，默认 127.0.0.1:3014（只给同机的 Caddy 访问）
# VITA_API_HOST=127.0.0.1
# PORT=3014

# SQLite 库文件所在目录，默认 .data/（相对于启动目录）
# VITA_API_DATA_DIR=/data

# 公共营养参考库（tools/reference-food 构建出的 reference-foods.json），默认在数据目录下。
# 读不到就拒绝启动。本地开发可以直接指向 iOS 的构建产物：
# VITA_API_REFERENCE_FILE=../ios/Resources/ReferenceFood/reference-foods.json

# 新建日期会话与确认卡过期按这个时区算，默认 Asia/Shanghai
# VITA_API_TIME_ZONE=Asia/Shanghai

# Google 健康（Google Health API）：服务端拉活动能量与睡眠（Google 健康不往 Apple 健康写这两项）。
# 在 Google Cloud 建 Web 应用类型的 OAuth 客户端，已获授权的重定向 URI 填下面的回调地址；
# OAuth 应用要发布为 In production，停在 Testing 时 refresh token 7 天就失效。三项都配了才启用。
# refresh token 用 VITA_API_SERVICE_TOKEN 派生的密钥加密存库，换服务令牌后要在 App 里重新连接。
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
# GOOGLE_HEALTH_REDIRECT_URI=https://vita-api.r4s.leonardo-zhu.me/oauth/google-health/callback
# Admin 的公网地址，Google 授权完成后跳回这里的 /admin/google-health。默认 https://vita.r4s.leonardo-zhu.me
# VITA_ADMIN_PUBLIC_URL=https://vita.r4s.leonardo-zhu.me
