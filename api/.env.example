# Vita API 的环境变量。复制为 .env.local 即可在本地 `pnpm dev`；生产在 R4S 的 /opt/stacks/vita-api/.env 维护。

# Admin 调 API 用的服务令牌，两边的 .env 填同一个值。至少 32 个字符，用 openssl rand -base64 32 生成。
# 更换后 Admin 要同步更新，手机的设备令牌不受影响。
VITA_API_SERVICE_TOKEN=

# 监听地址与端口，默认 127.0.0.1:3014（只给同机的 Caddy 访问）
# VITA_API_HOST=127.0.0.1
# PORT=3014

# SQLite 库文件所在目录，默认 .data/（相对于启动目录）
# VITA_API_DATA_DIR=/data

# 公共营养参考库（tools/reference-food 构建出的 reference-foods.json），默认在数据目录下。
# 读不到就拒绝启动。本地开发可以直接指向 iOS 的构建产物：
# VITA_API_REFERENCE_FILE=../ios/Resources/ReferenceFood/reference-foods.json

# 新建日期会话与确认卡过期按这个时区算，默认 Asia/Shanghai
# VITA_API_TIME_ZONE=Asia/Shanghai
