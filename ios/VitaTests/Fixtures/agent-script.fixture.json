  {
    "note": "活跃 Pending 存在时，新的独立写入被拒绝",
    "tool": "proposeRecordDeletion",
    "arguments": {
      "requestId": "$UUID",
      "sessionDate": "$DATE",
      "expectedRevision": "$REV",
      "payload": {
        "recordId": "$LAST_RECORD"
      }
    },
    "expect": {
      "ok": false,
      "errorCode": "pendingActive"
    },
    "then": "none"
  },
  {
    "note": "修正当前 Pending：香蕉改为 AI 估算的一份酸奶，然后取消",
    "tool": "proposeRecordChange",
    "arguments": {
      "requestId": "$UUID",
      "sessionDate": "$DATE",
      "expectedRevision": "$REV",
      "payload": {
        "intent": "create",
        "replacesPendingId": "$PENDING",
        "record": {
          "eventTime": {
            "precision": "approximate",
            "time": "15:30"
          },
          "items": [
            {
              "displayName": "酸奶",
              "originalAmountText": "一杯",
              "amountSource": "aiEstimated",
              "nutrition": {
                "source": "aiEstimated",
                "values": {
                  "energyKcal": 140,
                  "proteinG": 6,
                  "fatG": 5,
                  "carbohydrateG": 16
                },
                "estimateBasis": "一杯约 200g"
              }
            }
          ]
        }
      }
    },
    "expect": {
      "ok": true
    },
    "then": "cancel"
  },
  {
