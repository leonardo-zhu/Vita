[
  {
    "note": "新建午餐：熟鸡胸 150g（模型多带的营养值应被忽略）",
    "tool": "proposeRecordChange",
    "arguments": {
      "requestId": "$UUID",
      "sessionDate": "$DATE",
      "expectedRevision": "$REV",
      "payload": {
        "intent": "create",
        "record": {
          "eventTime": {
            "precision": "mealPeriod",
            "mealPeriod": "lunch"
          },
          "mealLabel": "午餐",
          "items": [
            {
              "displayName": "鸡胸肉",
              "originalAmountText": "150 克熟鸡胸",
              "quantity": {
                "amount": 150,
                "unit": "g"
              },
              "amountSource": "userStated",
              "nutrition": {
                "source": "referenceFood",
                "referenceFoodId": "vita.reference.chicken-breast.cooked",
                "values": {
                  "energyKcal": 9999,
                  "proteinG": 0,
                  "fatG": 0,
                  "carbohydrateG": 0
                }
              }
            }
          ]
        }
      }
    },
    "expect": {
      "ok": true
    },
    "then": "confirm"
  },
  {
    "note": "追加米饭 0.2kg（单位由客户端标准化）",
    "tool": "proposeRecordChange",
    "arguments": {
      "requestId": "$UUID",
      "sessionDate": "$DATE",
      "expectedRevision": "$REV",
      "payload": {
        "intent": "appendItems",
        "recordId": "$LAST_RECORD",
        "items": [
          {
            "displayName": "米饭",
            "originalAmountText": "一碗约 200g",
            "quantity": {
              "amount": 0.2,
              "unit": "kg"
            },
            "amountSource": "userStated",
            "nutrition": {
              "source": "referenceFood",
              "referenceFoodId": "vita.reference.rice.white.cooked",
              "values": {
                "energyKcal": 9999,
                "proteinG": 0,
                "fatG": 0,
                "carbohydrateG": 0
              }
            }
          }
        ]
      }
    },
    "expect": {
      "ok": true
    },
    "then": "confirm"
  },
  {
    "note": "把米饭改成 100g",
