          "amountSource": "userStated",
          "nutrition": {
            "source": "referenceFood",
            "referenceFoodId": "vita.reference.rice.white.cooked",
            "values": {
              "energyKcal": 9999,
              "proteinG": 0,
              "fatG": 0,
