{
  "$comment": "暴露给模型的工具清单与参数 schema（docs/contracts/agent-tools.md）。Vita API 发给模型，Admin 试跑时用同一份。只随代码发布，远程配置不能改；描述文字在 shared/config/DefaultConfig.json。",
  "tools": [
    {
      "name": "getDaySummary",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD，可省略"
          }
        }
      }
    },
    {
      "name": "getRecordDetail",
      "parameters": {
        "type": "object",
        "properties": {
          "recordId": {
            "type": "string"
          }
        },
        "required": [
          "recordId"
        ]
      }
    },
    {
      "name": "searchPersonalFoods",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "searchReferenceFoods",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "getGoals",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getHealthSnapshot",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getBodyComposition",
      "parameters": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "description": "往前看多少天的称重，默认 30。"
          }
        }
      }
    },
    {
      "name": "getGoalRecommendation",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "updateGoal",
      "parameters": {
        "type": "object",
        "properties": {
          "energyKcal": {
            "type": "number",
            "description": "固定的能量目标；给出后不再随活动变化"
          },
          "goalType": {
            "type": "string",
            "enum": [
              "maintain",
              "lose",
              "gain"
            ],
            "description": "目标类型；能量目标恢复随活动计算，调整幅度用该类型的默认值"
          },
          "energyPercent": {
            "type": "number",
            "description": "吃到每日消耗的百分比，如 85；能量目标随活动计算"
          },
          "energyAdjustmentKcal": {
            "type": "number",
            "description": "每天相对消耗多吃或少吃的千卡，缺口为负，如 -400；能量目标随活动计算"
          },
          "energyAuto": {
            "type": "boolean",
            "description": "true 时能量目标改回随活动计算，沿用上次的类型与调整"
          },
          "proteinG": {
            "type": "number"
          },
          "fatG": {
            "type": "number"
          },
          "carbohydrateG": {
            "type": "number"
          },
          "userCommand": {
            "type": "string",
            "description": "用户的原话，作为指令证据"
          }
        },
        "required": [
          "userCommand"
        ]
      }
    },
    {
      "name": "proposeRecordChange",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionDate": {
            "type": "string",
            "description": "YYYY-MM-DD，当前会话日期"
          },
          "expectedRevision": {
            "type": "integer",
            "description": "读取到的当天 revision"
          },
          "payload": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "enum": [
                  "create",
                  "appendItems",
                  "replaceItem",
                  "removeItem"
                ]
              },
              "recordId": {
                "type": "string",
                "description": "非 create 时必填"
              },
              "itemId": {
                "type": "string",
                "description": "replaceItem / removeItem 必填"
              },
              "record": {
                "type": "object",
                "description": "create 用",
                "properties": {
                  "eventTime": {
                    "$ref": "#/$defs/eventTime"
                  },
                  "mealLabel": {
                    "type": "string",
                    "enum": ["早餐", "午餐", "晚餐", "加餐"],
                    "description": "卡片标题，只能从这几个里选；拿不准就不填，App 会按时间段显示"
                  },
                  "note": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/item"
                    }
                  }
                },
                "required": [
                  "items"
                ]
              },
              "items": {
                "type": "array",
                "description": "appendItems 用",
                "items": {
                  "$ref": "#/$defs/item"
                }
              },
              "item": {
                "$ref": "#/$defs/item"
              },
              "replacesPendingId": {
                "type": "string"
              }
            },
            "required": [
              "intent"
            ]
          },
          "afterConfirm": {
            "type": "string",
            "description": "可选。用户这次的请求在这张卡片确认后还有下一步时填写，如“按 80 g 记录刚吃完的这份蛋糕”；用户确认后客户端会带着它让你继续。没有后续就省略。"
          }
        },
        "required": [
          "sessionDate",
          "payload"
        ],
        "$defs": {
          "eventTime": {
            "type": "object",
            "properties": {
              "precision": {
                "type": "string",
                "enum": [
                  "exact",
                  "approximate",
                  "mealPeriod",
                  "dateOnly"
                ]
              },
              "time": {
                "type": "string",
                "description": "HH:mm，exact / approximate 用"
              },
              "mealPeriod": {
                "type": "string",
                "enum": [
                  "breakfast",
                  "lunch",
                  "dinner",
                  "snack",
                  "other"
                ]
              }
            },
            "required": [
              "precision"
            ]
          },
          "item": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string"
              },
              "groupName": {
                "type": "string",
                "description": "这一项所属的菜或饮品名，如“拿铁”下的咖啡和牛奶都填“拿铁”。只在几项合起来是一道菜 / 一杯饮品时填，同一道菜的各项填同一个名字；单独吃的食品不填"
              },
              "originalAmountText": {
                "type": "string",
                "description": "用户的原始用量表达"
              },
              "quantity": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string",
                    "description": "g / kg / ml / L / 斤 / 两 等；计数单位须先换算"
                  }
                },
                "required": [
                  "amount",
                  "unit"
                ]
              },
              "amountSource": {
                "type": "string",
                "enum": [
                  "userMeasured",
                  "userStated",
                  "packageConversion",
                  "aiEstimated"
                ]
              },
              "nutrition": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "personalFoodVersion",
                      "referenceFood",
                      "aiEstimated"
                    ]
                  },
                  "foodVersionId": {
                    "type": "string"
                  },
                  "referenceFoodId": {
                    "type": "string"
                  },
                  "values": {
                    "type": "object",
                    "properties": {
                      "energyKcal": {
                        "type": "number"
                      },
                      "proteinG": {
                        "type": "number"
                      },
                      "fatG": {
                        "type": "number"
                      },
                      "carbohydrateG": {
                        "type": "number"
                      }
                    }
                  },
                  "estimateBasis": {
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "includeInSummary": {
                "type": "boolean",
                "description": "盐、葱花等可设 false"
              }
            },
            "required": [
              "displayName",
              "originalAmountText",
              "amountSource",
              "nutrition"
            ]
          }
        }
      }
    },
    {
      "name": "proposeRecordDeletion",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionDate": {
            "type": "string"
          },
          "expectedRevision": {
            "type": "integer"
          },
          "payload": {
            "type": "object",
            "properties": {
              "recordId": {
                "type": "string"
              },
              "replacesPendingId": {
                "type": "string"
              }
            },
            "required": [
              "recordId"
            ]
          },
          "afterConfirm": {
            "type": "string",
            "description": "可选。用户这次的请求在这张卡片确认后还有下一步时填写，如“按 80 g 记录刚吃完的这份蛋糕”；用户确认后客户端会带着它让你继续。没有后续就省略。"
          }
        },
        "required": [
          "sessionDate",
          "payload"
        ]
      }
    },
    {
      "name": "proposeFoodChange",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionDate": {
            "type": "string"
          },
          "expectedRevision": {
            "type": "integer"
          },
          "payload": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "enum": [
                  "createProduct",
                  "addVersion",
                  "updateProduct"
                ]
              },
              "productId": {
                "type": "string"
              },
              "expectedActiveVersionId": {
                "type": "string"
              },
              "product": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "brandOrSupplier": {
                    "type": "string"
                  },
                  "package": {
                    "type": "object",
                    "properties": {
                      "amount": {
                        "type": "number"
                      },
                      "unit": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "amount",
                      "unit"
                    ]
                  },
                  "note": {
                    "type": "string"
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "version": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "nutritionLabel",
                      "manualEntry",
                      "referenceDerived"
                    ]
                  },
                  "labelScanId": {
                    "type": "string"
                  },
                  "referenceFoodId": {
                    "type": "string"
                  },
                  "basis": {
                    "type": "object",
                    "properties": {
                      "amount": {
                        "type": "number"
                      },
                      "unit": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "amount",
                      "unit"
                    ]
                  },
                  "values": {
                    "type": "object",
                    "properties": {
                      "energyKcal": {
                        "type": "number"
                      },
                      "proteinG": {
                        "type": "number"
                      },
                      "fatG": {
                        "type": "number"
                      },
                      "carbohydrateG": {
                        "type": "number"
                      },
                      "sodiumMg": {
                        "type": "number"
                      },
                      "saturatedFatG": {
                        "type": "number"
                      },
                      "sugarG": {
                        "type": "number"
                      }
                    }
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "replacesPendingId": {
                "type": "string"
              }
            },
            "required": [
              "intent"
            ]
          },
          "afterConfirm": {
            "type": "string",
            "description": "可选。用户这次的请求在这张卡片确认后还有下一步时填写，如“按 80 g 记录刚吃完的这份蛋糕”；用户确认后客户端会带着它让你继续。没有后续就省略。"
          }
        },
        "required": [
          "sessionDate",
          "payload"
        ]
      }
    }
  ]
}
