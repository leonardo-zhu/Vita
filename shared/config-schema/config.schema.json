{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vita.leonardo-zhu.me/schemas/config.schema.json",
  "title": "Vita remote config",
  "description": "远程配置 config.json 的结构与取值约束，对应 docs/architecture/vita-admin.md §4 / §6。未知字段允许存在（客户端忽略），缺失字段回落到下一层。configVersion 单调递增、minClientVersion 不高于客户端版本这两条依赖运行时状态，不在 schema 内表达。",
  "type": "object",
  "required": ["schemaVersion", "configVersion"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "configVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "minClientVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "channel": { "enum": ["stable", "dev"] },
    "llm": {
      "type": "object",
      "properties": {
        "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 180 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 3 },
        "streaming": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "maxRecentMessages": { "type": "integer", "minimum": 1, "maximum": 100 },
        "includePersonalFoodSummary": { "type": "boolean" }
      }
    },
    "prompts": {
      "type": "object",
      "properties": {
        "system": {
          "type": "object",
          "required": ["id", "version", "text"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 },
            "text": { "type": "string", "minLength": 1, "maxLength": 20000 }
          }
        },
        "tools": {
          "type": "object",
          "description": "键为客户端已知的工具名；未知工具名由客户端忽略。",
          "additionalProperties": {
            "type": "object",
            "required": ["version", "description"],
            "properties": {
              "version": { "type": "integer", "minimum": 1 },
              "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}
